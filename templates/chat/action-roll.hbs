<div class="entity-chat entity-action-card">
  <header>
    <span class="entity-kicker">{{ability.trait}}</span>
    <h3>{{ability.label}} — {{state.resultLabel}}</h3>
  </header>

  <div class="entity-chat-target">
    <strong>Seuil ≤ {{state.target}}</strong>
    {{#if state.customAction}}
      <span>{{state.targetBreakdown}}</span>
    {{else}}
      <span>Trait {{state.traitValue}} + Capacité {{state.abilityValue}}{{#if state.passiveBonus}} + Structure {{state.passiveBonus}}{{/if}}{{#if state.improvementBonus}} + Amélioration {{state.improvementBonus}}{{/if}}</span>
    {{/if}}
  </div>

  <div class="entity-dice-row">
    {{#each state.diceDisplay as |die|}}
      <div class="entity-chat-die {{#if die.discarded}}discarded{{/if}}">
        <span>{{die.value}}</span>
        <div class="entity-die-tools">
          {{#unless ../rerollsLocked}}
            {{#if ../state.structureRerollAvailable}}
              <button type="button" data-entity-chat-action="reroll-structure" data-die-index="{{die.index}}" title="Relance gratuite de Structure — {{../state.structureRerollRemaining}} restante(s)">
                <i class="fa-solid fa-rotate"></i>
              </button>
            {{/if}}
            {{#if ../rerollItem}}
              <button type="button" data-entity-chat-action="reroll-improvement" data-die-index="{{die.index}}" data-item-id="{{../rerollItem.id}}" title="{{../rerollItem.name}} — {{../rerollItem.cost}}E">
                <i class="fa-solid fa-screwdriver-wrench"></i>
              </button>
            {{/if}}
          {{/unless}}
        </div>
      </div>
    {{/each}}
  </div>

  {{#if state.structureRerollAvailable}}
    <p class="entity-chat-note"><i class="fa-solid fa-building"></i> Relance(s) de Structure restante(s) : {{state.structureRerollRemaining}} / {{state.structureRerollMax}}.</p>
  {{/if}}

  {{#if rerollItem}}
    <p class="entity-chat-note"><i class="fa-solid fa-screwdriver-wrench"></i> {{rerollItem.name}} disponible : cliquez sur l’outil du dé à relancer ({{rerollItem.cost}}E).</p>
  {{/if}}

  {{#if state.activatedImprovements.length}}
    <p class="entity-chat-note"><strong>Activées :</strong> {{#each state.activatedImprovements}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p>
  {{/if}}

  {{#if state.shieldUsed}}
    <p class="entity-chat-success"><i class="fa-solid fa-shield-halved"></i> {{state.shieldName}} : Contrainte évitée.</p>
  {{/if}}

  {{#if isChallenge}}
    {{#unless state.encounterRecorded}}
      {{#if challengeNeedsConsequence}}
        <p class="entity-chat-note"><i class="fa-solid fa-triangle-exclamation"></i> Appliquez d’abord la conséquence de ce jet avant de l’enregistrer pour le Défi.</p>
      {{/if}}
      {{#if challengeCanRecord}}
        <div class="entity-chat-actions entity-encounter-record">
          <button type="button" data-entity-chat-action="record-encounter-roll">
            <i class="fa-solid fa-list-check"></i> Enregistrer pour le Défi
          </button>
        </div>
      {{/if}}
    {{else}}
      <p class="entity-chat-success"><i class="fa-solid fa-check"></i> Jet enregistré pour la Valeur de Menace.</p>
    {{/unless}}
  {{/if}}

  {{#if isOpportunity}}
    {{#unless state.encounterRecorded}}
      {{#if opportunityNeedsConsequence}}
        <p class="entity-chat-note"><i class="fa-solid fa-triangle-exclamation"></i> Appliquez d’abord la conséquence de ce jet, puis validez son résultat pour l’Opportunité.</p>
      {{/if}}
      {{#if opportunityCanRecord}}
        <div class="entity-chat-actions entity-encounter-record">
          <button type="button" data-entity-chat-action="record-opportunity-roll">
            <i class="fa-solid fa-list-check"></i> Valider pour l’Opportunité
          </button>
        </div>
      {{/if}}
    {{else}}
      {{#if (eq state.opportunityOutcome "success")}}
        <p class="entity-chat-success"><i class="fa-solid fa-check"></i> Opportunité réussie : le gain est disponible.</p>
      {{else}}
        <p class="entity-chat-note"><i class="fa-solid fa-xmark"></i> Opportunité échouée : aucun gain.</p>
      {{/if}}
    {{/unless}}
  {{/if}}

  {{#unless isSecondary}}
  {{#unless state.consequenceApplied}}
    {{#if (eq state.result "partial")}}
      <div class="entity-chat-actions">
        <button type="button" data-entity-chat-action="constraint"><i class="fa-solid fa-triangle-exclamation"></i> Ajouter une Contrainte</button>
        {{#each shields as |shield|}}
          <button type="button" data-entity-chat-action="shield" data-item-id="{{shield.id}}"><i class="fa-solid fa-shield-halved"></i> {{shield.name}} ({{shield.cost}}E)</button>
        {{/each}}
      </div>
    {{/if}}
    {{#if (eq state.result "failure")}}
      <div class="entity-chat-actions">
        <button type="button" data-entity-chat-action="failure"><i class="fa-solid fa-burst"></i> Ajouter une Défaillance</button>
      </div>
    {{/if}}
  {{/unless}}
  {{/unless}}

  <div class="entity-chat-actions entity-interpret-action">
    <button type="button" data-entity-chat-action="interpret-action">
      <i class="fa-solid fa-book-open-reader"></i> Interpréter le jet
    </button>
  </div>

  {{#if state.workflow.secondary}}
    {{#unless state.secondaryApplied}}
      <div class="entity-chat-actions entity-secondary-result-actions">
        {{#if (eq state.result "full")}}
          <button type="button" data-entity-chat-action="secondary-gain"><i class="fa-solid fa-box"></i> Appliquer le gain</button>
        {{/if}}
        {{#if (eq state.result "partial")}}
          <button type="button" data-entity-chat-action="secondary-gain"><i class="fa-solid fa-box"></i> Appliquer le demi-gain</button>
        {{/if}}
        {{#if (eq state.result "failure")}}
          <button type="button" data-entity-chat-action="secondary-challenge"><i class="fa-solid fa-triangle-exclamation"></i> Résoudre le Défi</button>
        {{/if}}
      </div>
    {{else}}
      {{#if state.secondaryGain}}
        <p class="entity-chat-success"><i class="fa-solid fa-check"></i> Gain appliqué : +{{state.secondaryGain}}.</p>
      {{/if}}
      {{#if (eq state.result "full")}}
        <div class="entity-chat-actions">
          <button type="button" data-entity-chat-action="secondary-oracles"><i class="fa-solid fa-wand-magic-sparkles"></i> Enrichir le résultat avec les Oracles</button>
        </div>
      {{/if}}
      {{#if (eq state.result "partial")}}
        <div class="entity-chat-actions">
          <button type="button" data-entity-chat-action="secondary-oracles"><i class="fa-solid fa-wand-magic-sparkles"></i> Enrichir le résultat avec les Oracles</button>
        </div>
      {{/if}}
    {{/unless}}
  {{/if}}
</div>