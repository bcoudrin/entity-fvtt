<div class="entity-pia-shell">
  <header class="entity-header">
    <div class="entity-brand">
      <span class="entity-kicker">PIONNIER INTERPLANÉTAIRE ADAPTATIF</span>
      <h1>ENTITÉ</h1>
    </div>
    <div class="entity-identity">
      <label>
        <span>Nom / Désignation</span>
        <input name="name" type="text" value="{{actor.name}}" />
      </label>
      <button type="button" data-action="openCreation"><i class="fa-solid fa-user-gear"></i> Création</button>
      <button type="button" data-action="openExpedition" {{#if creation.needsCreation}}disabled title="Terminez d’abord la création du PIA"{{/if}}><i class="fa-solid fa-rocket"></i> Mission / Expédition</button>
      <button type="button" data-action="openJournal"><i class="fa-solid fa-book"></i> Journal de bord</button>
    </div>
  </header>

  <section class="entity-resource-strip">
    <label><span>Énergie</span><input type="number" name="system.energy.value" value="{{system.energy.value}}" /><b>/ {{system.energy.max}}</b></label>
    <label><span>Ressources</span><input type="number" name="system.resources.value" value="{{system.resources.value}}" /><b>/ {{system.resources.max}}</b></label>
    <label><span>Données</span><input type="number" name="system.data.value" value="{{system.data.value}}" /><b>/ {{system.data.max}}</b></label>
  </section>

  <nav class="entity-tabs tabs" data-group="primary">
    <a class="{{tabs.systems.cssClass}}" data-action="tab" data-group="primary" data-tab="systems"><i class="fa-solid fa-microchip"></i> Systèmes</a>
    <a class="{{tabs.suit.cssClass}}" data-action="tab" data-group="primary" data-tab="suit"><i class="fa-solid fa-user-astronaut"></i> Combinaison</a>
    <a class="{{tabs.structures.cssClass}}" data-action="tab" data-group="primary" data-tab="structures"><i class="fa-solid fa-building"></i> Structures</a>
    <a class="{{tabs.journal.cssClass}}" data-action="tab" data-group="primary" data-tab="journal"><i class="fa-solid fa-book"></i> Journal</a>
  </nav>

  <section class="entity-body">
    <section class="tab {{tabs.systems.cssClass}}" data-group="primary" data-tab="systems">
      {{#if creation.needsCreation}}
        <section class="entity-panel entity-creation-required">
          <div>
            <span class="entity-kicker">INITIALISATION REQUISE</span>
            <h2>Configurer le PIA</h2>
            <p>Répartissez 3, 4 et 5 entre les Traits, puis 1, 2 et 3 entre les Capacités de chaque Trait avant de commencer une Mission.</p>
          </div>
          <button type="button" class="entity-primary" data-action="openCreation"><i class="fa-solid fa-user-gear"></i> Lancer l’assistant</button>
        </section>
      {{/if}}
      <div class="entity-traits-grid">
        {{#each traits as |trait|}}
          <section class="entity-panel entity-trait">
            <header>
              <h2>{{trait.label}}</h2>
              <input type="number" name="system.traits.{{trait.key}}.value" value="{{trait.value}}" min="0" />
            </header>
            <div class="entity-ability-list">
              {{#each trait.abilities as |ability|}}
                <div class="entity-ability-row">
                  <button type="button" class="entity-die" data-action="rollAbility" data-ability="{{ability.key}}" title="Lancer {{ability.label}}">
                    <i class="fa-solid fa-dice-d10"></i>
                  </button>
                  <span class="entity-ability-name">{{ability.label}}</span>
                  <input type="number" name="system.traits.{{trait.key}}.abilities.{{ability.key}}.value" value="{{ability.value}}" min="0" />
                  <span class="entity-target" title="Niveau de Difficulté avec bonus de Structures">≤ {{ability.target}}</span>
                </div>
              {{/each}}
            </div>
          </section>
        {{/each}}
      </div>

      {{#if pendingEffects.length}}
        <section class="entity-panel entity-pending">
          <header class="entity-panel-title">
            <h2>Améliorations armées</h2>
            <button type="button" data-action="clearPending"><i class="fa-solid fa-rotate-left"></i> Annuler et rembourser</button>
          </header>
          <div class="entity-chip-row">
            {{#each pendingEffects}}<span class="entity-chip">{{name}}</span>{{/each}}
          </div>
        </section>
      {{/if}}
    </section>

    <section class="tab {{tabs.suit.cssClass}}" data-group="primary" data-tab="suit">
      <section class="entity-panel entity-suit-panel">
        <header class="entity-panel-title">
          <div>
            <h2>Combinaison spatiale</h2>
            <p>{{suit.used}} / {{suit.max}} emplacements occupés</p>
          </div>
          <div class="entity-inline-actions">
            <button type="button" data-action="createImprovement"><i class="fa-solid fa-plus"></i> Module</button>
            <button type="button" data-action="addConstraint"><i class="fa-solid fa-triangle-exclamation"></i> Contrainte</button>
            <button type="button" data-action="addFailure"><i class="fa-solid fa-burst"></i> Défaillance</button>
          </div>
        </header>

        <div class="entity-suit-grid">
          {{#each suitSlots as |slot|}}
            <div class="entity-slot entity-slot-{{slot.kind}} {{#if slot.pending}}entity-slot-pending{{/if}}" title="{{slot.label}}" {{#if slot.itemId}}data-item-id="{{slot.itemId}}"{{/if}}>
              {{#if slot.itemId}}
                <button type="button" class="entity-slot-name" data-action="openItem" data-item-id="{{slot.itemId}}">
                  <i class="{{slot.icon}}"></i>
                  <span>{{slot.label}}</span>
                </button>
                <div class="entity-slot-meta">
                  <span class="entity-cost">{{slot.cost}}E</span>
                  <span class="entity-slot-status">{{slot.status}}</span>
                </div>
                <div class="entity-slot-actions">
                  {{#if slot.activatable}}
                    <button type="button" class="entity-slot-activate" data-action="activateImprovement" data-item-id="{{slot.itemId}}" title="Armer pour le prochain jet compatible">
                      <i class="fa-solid fa-bolt"></i><span>{{#if slot.pending}}Armé{{else}}Armer{{/if}}</span>
                    </button>
                  {{/if}}
                  <button type="button" data-action="openItem" data-item-id="{{slot.itemId}}" title="Détails">
                    <i class="fa-solid fa-circle-info"></i>
                  </button>
                  <button type="button" class="entity-danger" data-action="deleteItem" data-item-id="{{slot.itemId}}" title="Défausser">
                    <i class="fa-solid fa-trash"></i>
                  </button>
                </div>
              {{else}}
                <div class="entity-slot-condition">
                  {{#if slot.icon}}<i class="{{slot.icon}}"></i>{{/if}}
                  <span>{{slot.label}}</span>
                </div>
                {{#if slot.removable}}
                  <button type="button" class="entity-slot-remove" data-action="removeCondition" data-kind="{{slot.kind}}s" data-index="{{slot.index}}" title="Retirer">
                    <i class="fa-solid fa-xmark"></i>
                  </button>
                {{/if}}
              {{/if}}
            </div>
          {{/each}}
        </div>
      </section>
    </section>

    <section class="tab {{tabs.structures.cssClass}}" data-group="primary" data-tab="structures">
      <section class="entity-panel">
        <header class="entity-panel-title">
          <div>
            <h2>Structures</h2>
            <p>Les Structures sont permanentes et n’occupent pas la Combinaison.</p>
          </div>
          <button type="button" data-action="createStructure"><i class="fa-solid fa-plus"></i> Ajouter</button>
        </header>
        <ol class="entity-item-list">
          {{#each structures as |item|}}
            <li>
              <button type="button" class="entity-item-name" data-action="openItem" data-item-id="{{item.id}}">{{item.name}}</button>
              <span class="entity-chip">rang {{item.system.ranks}}</span>
              <span></span>
              <button type="button" class="entity-danger" data-action="deleteItem" data-item-id="{{item.id}}"><i class="fa-solid fa-trash"></i></button>
            </li>
          {{else}}
            <li class="entity-empty">Aucune Structure construite.</li>
          {{/each}}
        </ol>
      </section>
    </section>

    <section class="tab {{tabs.journal.cssClass}}" data-group="primary" data-tab="journal">
      <section class="entity-panel entity-discoveries-panel">
        <header class="entity-panel-title">
          <div>
            <h2>Découvertes</h2>
            <p>{{discoveries.revealed}} révélée(s) / {{discoveries.unlocked}} débloquée(s) / {{discoveries.total}}</p>
          </div>
          <button type="button" data-action="openJournal"><i class="fa-solid fa-book-open"></i> Ouvrir le Journal</button>
        </header>

        <div class="entity-discovery-progress">
          <div>
            <span>Révélées</span>
            <strong>{{discoveries.revealed}} / {{discoveries.total}}</strong>
          </div>
          <div>
            <span>Débloquées</span>
            <strong>{{discoveries.unlocked}} / {{discoveries.total}}</strong>
          </div>
          <div>
            <span>En attente</span>
            <strong>{{discoveries.pending}}</strong>
          </div>
        </div>

        {{#if discoveries.hasPending}}
          <div class="entity-discovery-ready">
            <i class="fa-solid fa-eye"></i>
            <div>
              <strong>Découverte {{discoveries.nextIndex}} disponible</strong>
              <p>Son contenu est encore masqué.</p>
            </div>
            <button type="button" class="entity-primary" data-action="revealDiscovery">Révéler</button>
          </div>
        {{else}}
          {{#if discoveries.complete}}
            <p class="entity-chat-success"><i class="fa-solid fa-circle-check"></i> Les 10 Découvertes ont été révélées.</p>
          {{else}}
            <p class="entity-empty">Accomplissez une Mission pour débloquer la prochaine Découverte.</p>
          {{/if}}
        {{/if}}
      </section>

      <section class="entity-panel entity-notes">
        <header class="entity-panel-title">
          <div>
            <h2>Notes rapides</h2>
            <p>Notes générales du PIA. Les Missions et Découvertes sont journalisées dans leurs pages dédiées.</p>
          </div>
          <button type="button" data-action="openJournal"><i class="fa-solid fa-book-open"></i> Ouvrir le Journal</button>
        </header>
        <textarea name="system.notes">{{system.notes}}</textarea>
      </section>
    </section>
  </section>
</div>